package lnbits:extension;
interface host {
  record storage-get-request { table: string, id: string }
  record storage-get-response { data-json: option<string> }
  record storage-set-request { table: string, data-json: string }
  record storage-set-response { ok: bool }
  record storage-paginated-request {
    table: string, filters-json: string, search: string, search-fields: list<string>,
    sort-by: string, descending: bool, limit: u32, offset: u32
  }
  record storage-paginated-response { rows-json: string, total: u64 }
  record invoice-request {
    wallet-id: string, amount: f64, currency: string, memo: string,
    tag: string, extra: list<tuple<string, string>>
  }
  record invoice-response { payment-hash: string, payment-request: string, checking-id: string }
  record user-wallet { id: string, name: string, currency: option<string> }
  record wallets-response { wallets: list<user-wallet> }
  record wallet-request { wallet-id: string }
  record balance-response {
    wallet-id: string, name: string, currency: option<string>, balance-msat: s64,
    balance-sat: s64, withdrawable-msat: s64, withdrawable-sat: s64,
    fee-reserve-msat: s64, fee-reserve-sat: s64, can-send-payments: bool
  }
  record pay-request {
    wallet-id: string, payment-request: string, max-sat: option<u64>,
    description: string, extra: list<tuple<string, string>>
  }
  record pay-response {
    ok: bool, error: option<string>, checking-id: option<string>, payment-hash: option<string>,
    status: option<string>, amount-msat: u64, fee-msat: u64, pending: bool, success: bool,
    payment-request: option<string>
  }
  record lnurl-request {
    wallet-id: string, lnurl: string, amount: f64, currency: string, comment: option<string>,
    description: string, max-sat: option<u64>, extra: list<tuple<string, string>>, fetch-only: bool
  }
  record random-request { prefix: string }
  record random-response { id: string }
  record now-response { timestamp: u64 }
  storage-get: func(request: storage-get-request) -> storage-get-response;
  storage-set: func(request: storage-set-request) -> storage-set-response;
  storage-get-paginated: func(request: storage-paginated-request) -> storage-paginated-response;
  list-user-wallets: func() -> wallets-response;
  wallet-balance: func(request: wallet-request) -> balance-response;
  create-invoice: func(request: invoice-request) -> invoice-response;
  pay-invoice: func(request: pay-request) -> pay-response;
  pay-lnurl: func(request: lnurl-request) -> pay-response;
  random-id: func(request: random-request) -> random-response;
  now: func() -> now-response;
}
interface utils-lnurl {
  record resolve-request { lnurl: string }
  record resolve-response {
    lnurl: string, domain: option<string>, description: string,
    min-sendable-msat: u64, max-sendable-msat: u64, comment-allowed: u64,
    fixed: bool, image: option<string>, metadata-json: string
  }
  resolve: func(request: resolve-request) -> resolve-response;
}
world wallet-sweep {
  import host;
  import utils-lnurl;
  export get-wallets: func(request-json: string) -> string;
  export get-balance: func(request-json: string) -> string;
  export create-quote: func(request-json: string) -> string;
  export create-plan: func(request-json: string) -> string;
  export get-plan: func(request-json: string) -> string;
  export get-history: func(request-json: string) -> string;
  export consolidate: func(request-json: string) -> string;
  export prepare-payout: func(request-json: string) -> string;
  export send-payout: func(request-json: string) -> string;
}
